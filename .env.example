# Copy to .env and fill in your keys
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Response cache for 'best:<category>' requests (bounded + TTL'd)
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=86400
# CACHE_MAX_ENTRIES=500

# Jev-style decisions — POST /v1/systemone
# Cascade (JEV_PROVIDER_ORDER, default ollama,typesafe,openrouter):
#   ollama     — local decision model on Ollama >= 0.35, free. JEV_LOCAL_MODEL
#                default tev1:4b-q4_K_M (2.7 GB); "nimble" (9B, 9.5 GB) is the
#                stronger option. Set JEV_LOCAL_MODEL= (empty) to skip local.
#   typesafe   — real Jev, key from console.typesafe.ai/keys
#   openrouter — Jev via OpenRouter /systemone (needs credits, not :free)
# If all fail, the chat cascade emulates the answers (JEV_EMULATE_FALLBACK=false disables).
TYPESAFE_API_KEY=
# JEV_LOCAL_MODEL=tev1:4b-q4_K_M
# JEV_PROVIDER_ORDER=ollama,typesafe,openrouter
# JEV_EMULATE_FALLBACK=true
