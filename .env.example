# Copy to .env and fill in your keys
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Response cache for 'best:<category>' requests (bounded + TTL'd)
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=86400
# CACHE_MAX_ENTRIES=500

# TypeSafe Jev (System One decisions) — POST /v1/systemone
# Direct key from console.typesafe.ai/keys (no card; $5/month credit reported).
# Without it the endpoint falls back to OpenRouter's /systemone (needs OpenRouter
# credits — Jev is not a :free model) and then to chat-model emulation.
TYPESAFE_API_KEY=
# JEV_EMULATE_FALLBACK=true   # set to false to fail hard instead of emulating
